
# ==============================================================================
# RustDesk Client Default Server Configuration (.env)
# ==============================================================================
# Changing this host applies to the entire desktop app, launcher, and server fetcher.
SERVER_HOST=192.168.1.22

# Server Ports
HBBS_PORT=21116
HBBR_PORT=21117
API_PORT=8000
API_SCHEME=http
 
# Full API Server URL
API_SERVER=http://192.168.1.22:8000  

# RustDesk Server Public Key (from your hbbs id_ed25519.pub)
KEY=DBq6By4uWAZ1gVgxQYoCXtvNWUyQJzrrIqT4FqYZ2pQ=
SERVER_KEY=DBq6By4uWAZ1gVgxQYoCXtvNWUyQJzrrIqT4FqYZ2pQ=

# Ninja Server API Key (for /api/devices/ and admin endpoints)
API_KEY=ninja-local-dev-key

# Default Unattended Access Password
PERMANENT_PASSWORD=Ninja@2026   

# ==============================================================================
# Emergency Cloudflare Beacon Fallback Configuration
# ==============================================================================
# Direct read-only HTTPS URL to config.json hosted on Cloudflare Pages
EMERGENCY_BEACON_URL=https://ninjadesk-beacon.pages.dev/config.json

# Consecutive server offline threshold before calling beacon (in minutes)
EMERGENCY_FAILOVER_MINUTES=30
